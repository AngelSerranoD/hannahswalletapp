# Cabeceras de seguridad para Netlify y Cloudflare Pages.
#
# Se sirven desde aquí y no solo con etiquetas <meta> porque tres de las más
# importantes -frame-ancestors, X-Content-Type-Options y Permissions-Policy-
# el navegador solo las obedece si llegan como cabecera HTTP real.
#
# Para otros servidores hay equivalentes en el README.

/*
  # Nadie puede meter la app dentro de un iframe. Sin esto, una página
  # cualquiera podría incrustarla y superponer botones invisibles para que
  # pulses cosas sin darte cuenta (clickjacking).
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; manifest-src 'self'; base-uri 'self'; form-action 'none'; object-src 'none'; frame-ancestors 'none'
  X-Frame-Options: DENY

  # Impide que el navegador "adivine" el tipo de un fichero y acabe ejecutando
  # como script algo que se sirvió como texto.
  X-Content-Type-Options: nosniff

  # No filtrar a dónde se navega. Esta app no enlaza fuera, pero si algún día
  # lo hiciera, la URL no debe viajar en la cabecera Referer.
  Referrer-Policy: no-referrer

  # Se desactiva todo lo que la app no usa. `publickey-credentials-get` sí se
  # permite: es lo que necesita WebAuthn para Face ID.
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=(), interest-cohort=(), publickey-credentials-get=(self)

  # HTTPS obligatorio durante un año, subdominios incluidos.
  Strict-Transport-Security: max-age=31536000; includeSubDomains

  # Aísla la app de otras pestañas del mismo navegador.
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# El service worker y el index nunca se cachean con la versión antigua: si se
# quedaran pegados, una corrección de seguridad no llegaría al usuario.
/index.html
  Cache-Control: no-cache

/flutter_service_worker.js
  Cache-Control: no-cache

/manifest.json
  Cache-Control: no-cache
